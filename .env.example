# Brightloop Security & Supabase Environment Configuration
# Replace with your Supabase Project URL and Anon/Public Key from your Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Dedicated Backend Port & Host
BRIGHTLOOP_HOST=127.0.0.1
BRIGHTLOOP_PORT=8000
BRIGHTLOOP_JWT_SECRET=your-supabase-jwt-secret-or-secure-random-key-at-least-32-chars

